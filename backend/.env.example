# --- Required in production ---
# Random secret used to sign login cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Hosted Postgres connection string (Neon, Supabase, Vercel Postgres ...). Leave empty locally to use SQLite.
DATABASE_URL=

# --- Optional ---
# APP_ENV=production            # set automatically on Vercel
# CORS_ORIGINS=https://your-site.vercel.app   # only needed if the browser calls the API directly
