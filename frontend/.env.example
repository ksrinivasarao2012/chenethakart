# URL of the FastAPI backend (no trailing slash).
# Local: http://127.0.0.1:8000   |   Vercel: your backend project's URL (required, the build fails without it)
API_URL=http://127.0.0.1:8000

# Public URL of this site, used for sitemap, canonical links and social previews.
# Optional on Vercel (falls back to the project's production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
